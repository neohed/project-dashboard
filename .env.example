# Colon-separated list of directory prefixes that local_path is allowed to
# resolve into. Native dev defaults to /home:/Users if unset — override this
# to scope it tighter, and override it in docker-compose.yml when running in
# a container (see README).
ALLOWED_BASE_PATHS=/home:/Users

# Directory the SQLite DB and uploaded images are stored in. Defaults to
# ./data relative to the project root if unset.
DATABASE_DIR=./data

# Docker only: the directory holding your repos. docker-compose.yml mounts it
# read-only at the same path inside the container and allow-lists it, so
# local_path values are identical in Docker, native dev and the MCP server.
PROJECTS_DIR=/home/you/workspace
